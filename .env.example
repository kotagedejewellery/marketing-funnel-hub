# KGJ Marketing Funnel Hub environment contract
# Copy this file to .env.local and provide environment-specific values.
# Never commit a populated environment file.

# Public application boundary
# Owner: Engineering / Platform
# Allowed: local | staging | production
NEXT_PUBLIC_APP_ENV=

# Public canonical application URL. HTTPS is required outside local development.
# Owner: Engineering / Platform
NEXT_PUBLIC_SITE_URL=

# Public Supabase API URL and publishable key. These are safe for browser use only
# with the approved RLS and browser-access boundaries.
# Owner: Engineering / Platform
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public analytics identifiers. GA4 dispatch remains owned by GTM.
# Owner: Marketing / Analytics
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=

# Server-only direct PostgreSQL connection for the least-privilege application role.
# Owner: Engineering / Platform
DATABASE_URL=

# Local migration CLI only. Use the local Supabase administrator connection on
# 127.0.0.1:54322; never expose this credential to the application runtime or
# configure it in a Vercel application environment.
# Owner: Engineering / Platform
DATABASE_MIGRATION_URL=

# Server-only Supabase key for approved Auth administration and Storage operations.
# Never prefix this variable with NEXT_PUBLIC_.
# Owner: Engineering / Platform
SUPABASE_SECRET_KEY=

# Supabase bucket configuration. Writes remain server-authorized.
# Owner: Engineering / Platform
SUPABASE_PUBLIC_ASSET_BUCKET=
SUPABASE_PRIVATE_MEDIA_BUCKET=

# Server-only Meta Conversions API configuration.
# Owner: Marketing / Analytics (account); Engineering / Platform (secret custody)
META_CAPI_DATASET_ID=
META_CAPI_ACCESS_TOKEN=

# Deployment-edge event rate-limit configuration. No implicit thresholds are used.
# Owner: Engineering / Platform
EVENT_RATE_LIMIT_WINDOW_SECONDS=
EVENT_RATE_LIMIT_PER_IP=
EVENT_RATE_LIMIT_GLOBAL=

# Server-only Vercel Cron authorization secret for the retention job.
# Use a random value of at least 16 characters and keep the job disabled until tested.
# Owner: Engineering / Platform
CRON_SECRET=

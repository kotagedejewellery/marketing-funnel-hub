# Copy to .env.local. Never commit populated environment files.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_META_PIXEL_ID=

# Runtime uses the restricted application role. The local Compose defaults are
# documented in README; never use a production password here.
DATABASE_URL=postgresql://kgj_app:local-app-password@127.0.0.1:54329/kgj?sslmode=disable
DATABASE_SSL=false

# Local migration command only. It is the PostgreSQL owner URL, never runtime.
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:54329/kgj?sslmode=disable

# Server-only internal CMS and tracking secrets, at least 32 random characters.
ADMIN_SESSION_SECRET=
TRACKING_HMAC_SECRET=
CRON_SECRET=

# Server-only local storage. The public route serves only validated image paths.
MEDIA_STORAGE_ROOT=.media
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/media

# Optional provider configuration.
META_CAPI_ACCESS_TOKEN=
META_TRACKING_CONFIG_ENCRYPTION_KEY=
META_AD_ACCOUNT_ID=
META_MARKETING_API_ACCESS_TOKEN=
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=
FIRECRAWL_API_KEY=
TRACKING_ENABLED=false

# KGJ live environment reference
#
# Copy applicable values into Vercel's Production environment. Never commit a
# populated environment file. GTM is intentionally not used; do not configure
# NEXT_PUBLIC_GTM_CONTAINER_ID in Vercel.

# Public application boundary
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Meta browser/server tracking. All three are required only when
# TRACKING_ENABLED=true.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
TRACKING_ENABLED=false

# Server-only application access
DATABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLIC_ASSET_BUCKET=public-assets
CRON_SECRET=

# Optional Meta Ads Insights panel. This token is separate from the CAPI token.
META_AD_ACCOUNT_ID=
META_MARKETING_API_ACCESS_TOKEN=

# Optional GA4 Analytics-provider panel only. It does not enable GTM or browser
# GA4 event delivery.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional manual Google Maps review import.
FIRECRAWL_API_KEY=

# One-time owner-run Drizzle migration connection. Keep this only in a local
# .env.live.local file when running `pnpm db:migrate:live`; do not set it in
# Vercel and do not reuse DATABASE_URL.
DATABASE_LIVE_MIGRATION_URL=

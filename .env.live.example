# KGJ live environment reference
#
# Copy applicable values into Vercel's Production environment or an ignored
# .env.production on the owner-managed Docker host. Never commit a populated
# environment file. GTM is intentionally not used.

# Public application boundary. For self-hosted Supabase, point this to its
# HTTPS API endpoint, never its internal Docker hostname.
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SUPABASE_URL=https://supabase.your-domain.example
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Meta browser/server tracking. All three are required only when
# TRACKING_ENABLED=true.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
TRACKING_ENABLED=false

# Server-only application access. The application container joins the private
# external Docker network `supabase_default`; use its PostgreSQL service name.
# Percent-encode reserved password characters. Do not expose this URL publicly.
DATABASE_URL=postgresql://postgres:replace-with-password@supabase-db:5432/postgres?sslmode=disable
SUPABASE_SECRET_KEY=
SUPABASE_PUBLIC_ASSET_BUCKET=public-assets
CRON_SECRET=

# Optional Meta Ads Insights panel. This token is separate from the CAPI token.
META_AD_ACCOUNT_ID=
META_MARKETING_API_ACCESS_TOKEN=

# Optional GA4 Analytics-provider panel only. It does not enable GTM or browser
# GA4 event delivery.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional manual Google Maps review import.
FIRECRAWL_API_KEY=

# One-time owner-run Drizzle migration connection. Keep this only in a local
# migration environment attached to `supabase_default`; do not set it in the
# application runtime and do not reuse DATABASE_URL.
DATABASE_LIVE_MIGRATION_URL=

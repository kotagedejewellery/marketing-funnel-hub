# Copy applicable values to the ignored .env.production on VPS 1 and to the
# DOCKER_BUILD_ENV GitHub secret. Never commit populated values.
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://link.kotagedejewellery.com
NEXT_PUBLIC_META_PIXEL_ID=

# Runtime uses only the internal application role and private Docker network.
DATABASE_URL=postgresql://kgj_app:replace-with-url-encoded-app-password@db:5432/kgj?sslmode=disable
DATABASE_SSL=false

# Generate each with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
TRACKING_HMAC_SECRET=
CRON_SECRET=

# Docker mounts this named volume at /app/media. The app serves public images.
MEDIA_STORAGE_ROOT=/app/media
MEDIA_PUBLIC_BASE_URL=https://link.kotagedejewellery.com/media

# Compose service provisioning only. These are not read by the Next.js app.
POSTGRES_DB=kgj
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=

# Optional provider configuration.
META_CAPI_ACCESS_TOKEN=
META_TRACKING_CONFIG_ENCRYPTION_KEY=
META_AD_ACCOUNT_ID=
META_MARKETING_API_ACCESS_TOKEN=
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=
FIRECRAWL_API_KEY=
TRACKING_ENABLED=false

# Copy to the ignored .env.migration only for an owner-approved migration.
# This file is read only by the one-shot migration container, never by app.
DATABASE_LIVE_MIGRATION_URL=postgresql://postgres:replace-with-url-encoded-owner-password@db:5432/kgj?sslmode=disable

# Source is read-only. This URL is never loaded by the runtime application.
SOURCE_DATABASE_URL=
CUTOVER_CONFIRMATION=
MEDIA_COPY_VERIFIED=false

# Required only when bootstrapping the first internal technical admin.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
